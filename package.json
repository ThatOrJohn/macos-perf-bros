{
  "name": "macos-perf-bros",
  "version": "0.0.0",
  "description": "A terminal system monitor for Apple Silicon Macs, presented as an original NES-style platformer.",
  "license": "MIT",
  "author": "John Walley",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThatOrJohn/macos-perf-bros.git"
  },
  "homepage": "https://github.com/ThatOrJohn/macos-perf-bros#readme",
  "bugs": {
    "url": "https://github.com/ThatOrJohn/macos-perf-bros/issues"
  },
  "keywords": [
    "macos",
    "apple-silicon",
    "system-monitor",
    "tui",
    "terminal",
    "bun",
    "opentui",
    "powermetrics"
  ],
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "private": true,
  "type": "module",
  "bin": {
    "perf-bros": "src/main.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "bench:parse": "bun run scripts/bench-parse.ts",
    "demo": "bun run src/main.ts --demo",
    "stills": "bun run src/main.ts --png docs/stills",
    "start": "bun run src/main.ts",
    "bench:render": "bun run scripts/bench-render.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@opentui/core": "^0.9.8"
  }
}
